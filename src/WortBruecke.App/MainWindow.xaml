<Window x:Class="WortBruecke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LernType"
        Width="1180" Height="760" MinWidth="720" MinHeight="520"
        Icon="Assets/Brand/LernType.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="LernType — путь немецкого языка от Pre-A1 до C2">
    <Grid x:Name="RootSurface" ClipToBounds="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource Brush.AppBackdrop}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid x:Name="BackdropDecorations" IsHitTestVisible="False" Focusable="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse Width="720" Height="720" Margin="90,-430,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Brush.AuraAccent}" />
            <Ellipse Width="760" Height="760" Margin="0,0,-310,-450" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.AuraSecondary}" />
        </Grid>

        <Grid Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ResponsiveNavigationWidth}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource GlassNavigation}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="34" Height="34" Background="{DynamicResource Brush.Accent}" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}" FontFamily="{DynamicResource Font.Display}" FontSize="18" FontWeight="Bold" Text="L" />
                        </Border>
                            <TextBlock Margin="10,2,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="SemiBold" Text="LernType"
                                       Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=1060}" />
                    </StackPanel>
                    <TextBlock Margin="44,2,0,0" Style="{StaticResource MetaText}" Text="DEUTSCH ÜBEN"
                               Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=1060}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,4" Style="{StaticResource NavButton}" Command="{Binding Command}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" Data="{Binding Icon}"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="0.45" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                   FontWeight="SemiBold" Text="{Binding Title}"
                                                   Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=1060}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Padding="13" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=1060}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaText}" Text="ЯЗЫКОВАЯ ПАРА" />
                            <TextBlock Margin="0,5,0,0" FontSize="14" FontWeight="SemiBold" Text="Русский → Deutsch" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="8" Height="8" Background="{DynamicResource Brush.Success}" CornerRadius="4" VerticalAlignment="Center" ToolTip="Локальная база готова" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GlassToolbar}" BorderThickness="0,0,0,1">
                <Grid Margin="34,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14" Text="{Binding CurrentTitle}" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Padding="9,5" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource Brush.Success}" CornerRadius="4" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ReadinessLabel}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ProgressBar Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Accent}" Background="Transparent"
                                 Visibility="{Binding IsShellBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Загрузка раздела" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="24,14,24,0" Padding="16,13" Style="{StaticResource GlassInset}"
                    BorderBrush="{DynamicResource Brush.Error}" CornerRadius="{DynamicResource Radius.Card}"
                    Visibility="{Binding HasShellError, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Ошибка приложения">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding ShellErrorMessage}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MetaText}" Text="{Binding ShellTechnicalCode, StringFormat=Код: {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button MinWidth="104" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCommand}" Content="Повторить" />
                        <Button Margin="8,0,0,0" MinWidth="92" Style="{StaticResource SecondaryButton}" Command="{Binding DismissErrorCommand}" Content="Закрыть" />
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" />
        </Grid>
        </Grid>
    </Grid>
</Window>
