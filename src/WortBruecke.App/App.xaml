<Application x:Class="WortBruecke.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WortBruecke.App.Infrastructure"
             xmlns:vm="clr-namespace:WortBruecke.App.ViewModels"
             xmlns:views="clr-namespace:WortBruecke.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Tokens.xaml" />
                <ResourceDictionary Source="Resources/LightTheme.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <infra:BooleanToStatusBrushConverter x:Key="StatusBrushConverter" />
            <infra:LocalizedTextConverter x:Key="LocalizedTextConverter" />
            <infra:WindowWidthToVisibilityConverter x:Key="WindowWidthVisibility" />
            <infra:WindowWidthToNavigationWidthConverter x:Key="ResponsiveNavigationWidth" />
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CoursePathViewModel}">
                <views:CoursePathView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CourseLessonViewModel}">
                <views:CourseLessonView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InteractiveExercisesViewModel}">
                <views:InteractiveExercisesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrainerViewModel}">
                <views:TrainerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TextPracticeViewModel}">
                <views:TextPracticeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VocabularyTestViewModel}">
                <views:VocabularyTestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioPracticeViewModel}">
                <views:AudioPracticeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
                <views:ProgressView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
