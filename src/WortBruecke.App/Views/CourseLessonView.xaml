<UserControl x:Class="WortBruecke.App.Views.CourseLessonView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Урок курса LernType"
             KeyboardNavigation.TabNavigation="Continue">
    <ScrollViewer x:Name="LessonScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,52" MaxWidth="980" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Width="44" Height="44" Padding="0" Style="{StaticResource IconButton}" Command="{Binding ReturnCommand}"
                        ToolTip="Вернуться к курсу" AutomationProperties.Name="Вернуться к курсам">
                    <Path Width="17" Height="17" Data="{StaticResource Icon.ArrowRight}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" Stretch="Uniform">
                        <Path.RenderTransform><ScaleTransform ScaleX="-1" CenterX="8.5" /></Path.RenderTransform>
                    </Path>
                </Button>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding FlowLabel}" />
                    <TextBlock Margin="0,4,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="SemiBold" Text="{Binding FlowTitle}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding CourseTitle}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="14,10" Style="{StaticResource GlassInset}" CornerRadius="14">
                    <StackPanel>
                        <Grid Width="170"><TextBlock Style="{StaticResource MetaText}" Text="ШАГ" /><TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding PositionText}" /></Grid>
                        <ProgressBar Margin="0,8,0,0" Width="170" Height="5" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Margin="58,12,0,0" MaxWidth="760" Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="20" Text="{Binding FlowOutcome}" TextWrapping="Wrap" />

            <Grid Margin="0,26,0,0" Visibility="{Binding IsFlowComplete, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Border Padding="28" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Padding="10,6" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="9">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding StepKindText}" />
                            </Border>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="SemiBold" Text="{Binding StepTitle}" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14" LineHeight="22" Text="{Binding Instruction}" TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0" Padding="18" Style="{StaticResource GlassInset}" CornerRadius="14"
                                Visibility="{Binding HasRussianText, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetaText}" Text="ОБЪЯСНЕНИЕ" />
                                <TextBlock Margin="0,8,0,0" FontSize="14" LineHeight="23" Text="{Binding RussianText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource Brush.GlassStrong}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="14"
                                Visibility="{Binding HasGermanText, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="DEUTSCH" />
                                <TextBlock Margin="0,8,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="17" LineHeight="26" Text="{Binding GermanText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource Brush.GlassInset}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="12"
                                Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetaText}" Text="СХЕМА" />
                                <TextBlock Margin="0,9,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="22" Text="{Binding TableText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="14,11" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="11"
                                Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Width="15" Height="15" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.7" Stretch="Uniform" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warning}" FontSize="12" Text="{Binding Hint}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="24" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Margin="0,0,0,16" Padding="16,13" Background="{DynamicResource Brush.GlassStrong}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="12"
                                Visibility="{Binding HasTaskPrompt, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Задание урока">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ЗАДАНИЕ" />
                                <TextBlock Margin="0,7,0,0" FontSize="14" FontWeight="SemiBold" LineHeight="22" Text="{Binding TaskPrompt}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding ShowAnswerInput, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MetaText}" Text="ВАШ ОТВЕТ" />
                            <TextBox Margin="0,9,0,0" MinHeight="48" Padding="13,11" FontSize="15" Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditAnswer}"
                                     AutomationProperties.Name="Ответ на задание" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MetaText}" Text="ВЫБЕРИТЕ ОТВЕТ" />
                            <ListBox Margin="0,9,0,0" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                     IsEnabled="{Binding CanEditAnswer}"
                                     AutomationProperties.Name="Варианты ответа" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowAudioTask, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MetaText}" Text="{Binding AudioSectionTitle}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" LineHeight="20" Text="{Binding AudioInstructionText}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,15,0,0">
                                <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding ListenCommand}" IsEnabled="{Binding HasGermanVoice}" AutomationProperties.Name="Прослушать немецкий аудиофрагмент">
                                    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Icon.Audio}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding ListenButtonText}" /></StackPanel>
                                </Button>
                            </WrapPanel>
                            <WrapPanel Visibility="{Binding IsSpeakingTask, Converter={StaticResource BoolToVisibility}}">
                                <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding StartRecordingCommand}" IsEnabled="{Binding HasMicrophone}" AutomationProperties.Name="Начать запись ответа">
                                    <TextBlock Style="{StaticResource ButtonContentText}" Text="Записать ответ" />
                                </Button>
                                <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding StopRecordingCommand}" AutomationProperties.Name="Остановить запись">
                                    <TextBlock Style="{StaticResource ButtonContentText}" Text="Остановить" />
                                </Button>
                                <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding PlayRecordingCommand}" AutomationProperties.Name="Прослушать свою запись">
                                    <TextBlock Style="{StaticResource ButtonContentText}" Text="Моя запись" />
                                </Button>
                            </WrapPanel>
                            <Border Margin="0,7,0,0" Padding="13,10" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="10" Visibility="{Binding ShowListeningTranscriptFallback, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Warning}" Text="{Binding ListeningTranscriptFallbackText}" TextWrapping="Wrap" />
                            </Border>
                            <Border Margin="0,7,0,0" Padding="14,11" Background="{DynamicResource Brush.GlassStrong}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="11"
                                    Visibility="{Binding ShowSpeakingModelText, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Образец устного ответа">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ОБРАЗЕЦ ОТВЕТА" />
                                    <TextBlock Margin="0,7,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="15" LineHeight="23" Text="{Binding SpeakingModelText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,7,0,0" Padding="13,10" Style="{StaticResource GlassInset}" CornerRadius="10" Visibility="{Binding HasAudioStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding AudioStatus}" TextWrapping="Wrap" />
                            </Border>
                            <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding CompleteSpeakingCommand}" AutomationProperties.Name="Засчитать устный шаг" Visibility="{Binding IsSpeakingTask, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding SpeakingCompletionText}" />
                            </Button>
                        </StackPanel>

                        <Border Margin="0,16,0,0" Padding="15,12" Background="{DynamicResource Brush.GlassStrong}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="12"
                                Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="9"><Path Width="13" Height="13" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.8" Stretch="Uniform" /></Border>
                                <TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12" LineHeight="19" Text="{Binding Feedback}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="Строгая проверка немецкого · без сетевого ИИ" />
                            <Button Grid.Column="1" MinWidth="130" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                                    Visibility="{Binding ShowSubmit, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Проверить ответ">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить" />
                            </Button>
                            <Button Grid.Column="2" Margin="10,0,0,0" MinWidth="124" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}"
                                    AutomationProperties.Name="{Binding NextButtonText}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding NextButtonText}" /><Path Width="15" Height="15" Margin="9,0,0,0" Data="{StaticResource Icon.ArrowRight}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Stretch="Uniform" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,26,0,0" Padding="30" Style="{StaticResource Panel}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive">
                <StackPanel HorizontalAlignment="Center" MaxWidth="660">
                    <Border Width="64" Height="64" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="19">
                        <Path Width="29" Height="29" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2.1" Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Display}" FontSize="26" FontWeight="SemiBold" Text="Этап завершён" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14" LineHeight="22" Text="{Binding ResultText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource MetaText}" Text="Результат сохранён локально" />
                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button MinWidth="138" Style="{StaticResource SecondaryButton}" Command="{Binding RestartCommand}" AutomationProperties.Name="Повторить этап">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Повторить" />
                        </Button>
                        <Button Margin="10,0,0,0" MinWidth="164" Style="{StaticResource PrimaryButton}" Command="{Binding ReturnCommand}" AutomationProperties.Name="Вернуться к курсу">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ButtonContentText}" Text="Вернуться к курсу" /><Path Width="15" Height="15" Margin="9,0,0,0" Data="{StaticResource Icon.ArrowRight}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Stretch="Uniform" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
