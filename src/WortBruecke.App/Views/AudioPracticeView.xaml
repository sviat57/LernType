<UserControl x:Class="WortBruecke.App.Views.AudioPracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Аудирование и устная практика">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,48" MaxWidth="1160" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" Margin="0,0,17,0" Style="{StaticResource IconTile}" VerticalAlignment="Center">
                        <Path Width="27" Height="27" Data="{StaticResource Icon.Audio}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ОФЛАЙН · ГОЛОС WINDOWS · ЗАПИСИ ВРЕМЕННЫЕ" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource HeroTitle}" FontSize="34" Text="Слушайте. Говорите. Сравнивайте." />
                        <TextBlock Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource BodySecondary}"
                                   Text="Диктант проверяет текст. Устный ответ остаётся только в этой сессии — вы сравниваете его по собственной записи." />
                    </StackPanel>
                </Grid>
                <Button Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReturnToLevelCommand}"
                        Visibility="{Binding HasLevelContext, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.ChevronLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" />
                        <TextBlock Text="{Binding ReturnToLevelText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.78*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="1.45*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="22" CornerRadius="{DynamicResource Radius.Card}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassInset}"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;980}" Value="Visible"><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" Margin="0,0,12,0" Style="{StaticResource IconTile}">
                                    <Path Width="20" Height="20" Data="{StaticResource Icon.Audio}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ПАРАМЕТРЫ СЕССИИ" />
                                    <TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="Задание и устройство" />
                                </StackPanel>
                            </StackPanel>

                            <Label Margin="0,22,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Задание" Target="{Binding ElementName=AudioPromptSelector}" />
                            <ComboBox x:Name="AudioPromptSelector" ItemsSource="{Binding Prompts}" SelectedItem="{Binding SelectedPrompt}" DisplayMemberPath="DisplayTitle"
                                      IsEnabled="{Binding CanSelectAudioOptions}"
                                      AutomationProperties.Name="Выбрать уровень и аудиозадание" />

                            <Label Margin="0,20,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Микрофон" Target="{Binding ElementName=AudioDeviceSelector}" />
                            <ComboBox x:Name="AudioDeviceSelector" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanSelectAudioOptions}"
                                      AutomationProperties.Name="Выбрать микрофон" />

                            <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource Brush.ErrorSoft}" BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" VerticalAlignment="Top" Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource Brush.Error}" StrokeThickness="1.8" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Top" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Info}" StrokeThickness="1.8" Stretch="Uniform" />
                                    <TextBlock FontSize="12" LineHeight="18" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                               Text="Микрофон используется локально. Запись удаляется при завершении сессии." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="2" /><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;980}" Value="Visible"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,20,0,0" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <Border Padding="22" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="42" Height="42" Margin="0,0,12,0" Style="{StaticResource IconTile}">
                                            <Path Width="20" Height="20" Data="{StaticResource Icon.Play}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ШАГ 1" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource SectionTitle}" FontSize="21" Text="Аудирование и диктант" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" Style="{StaticResource StatusPill}">
                                        <TextBlock Style="{StaticResource MetaText}" Text="ТЕКСТ СКРЫТ" />
                                    </Border>
                                </Grid>

                                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding ListenCommand}" AutomationProperties.Name="Прослушать немецкую фразу">
                                    <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Margin="0,0,9,0" Data="{StaticResource Icon.Play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Text="Прослушать фразу" /></StackPanel>
                                </Button>
                                <Label Margin="0,16,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Что вы услышали" Target="{Binding ElementName=TranscriptBox}" />
                                <TextBox x:Name="TranscriptBox" Text="{Binding Transcript, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="88"
                                         TextWrapping="Wrap" AutomationProperties.Name="Введите услышанную немецкую фразу" />
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding CheckTranscriptCommand}" AutomationProperties.Name="Проверить диктант">
                                    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Check}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить диктант" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="22" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="42" Height="42" Margin="0,0,12,0" Style="{StaticResource IconTile}">
                                            <Path Width="20" Height="20" Data="{StaticResource Icon.Microphone}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ШАГ 2" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource SectionTitle}" FontSize="21" Text="Устный ответ" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="11,6" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}">
                                        <StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Icon.Microphone}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding TimerText}" /></StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Style="{StaticResource BodySecondary}" Text="{Binding SelectedPrompt.SpeakingInstruction}" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding StartTimedRecordingCommand}" AutomationProperties.Name="Начать подготовку и запись">
                                        <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Microphone}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Подготовка и запись" /></StackPanel>
                                    </Button>
                                    <Button Margin="0,0,8,8" Style="{StaticResource DangerButton}" Command="{Binding StopRecordingCommand}" AutomationProperties.Name="Остановить запись">
                                        <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,9,0" Data="{StaticResource Icon.Pause}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Stretch="Uniform" /><TextBlock Text="Остановить" /></StackPanel>
                                    </Button>
                                    <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding PlayRecordingCommand}" AutomationProperties.Name="Прослушать запись">
                                        <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Play}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Text="Прослушать себя" /></StackPanel>
                                    </Button>
                                </WrapPanel>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource MetaText}" Text="САМООЦЕНКА ЗАПИСИ" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RateSpeakingCommand}" CommandParameter="0.4" Content="Нужно повторить" />
                                        <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RateSpeakingCommand}" CommandParameter="0.75" Content="Смысл передан" />
                                        <Button Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding RateSpeakingCommand}" CommandParameter="1" Content="Уверенный ответ" />
                                    </WrapPanel>
                                </StackPanel>

                                <Border Margin="0,12,0,0" Padding="15" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}"
                                        Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Width="17" Height="17" VerticalAlignment="Top" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Text="{Binding Feedback}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="14" Background="{DynamicResource Brush.GlassSubtle}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Top" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.8" Stretch="Uniform" />
                    <TextBlock Style="{StaticResource BodySecondary}" FontSize="12" TextWrapping="Wrap"
                               Text="Самооценка речи имеет низкий уровень доказательности и не повышает экзаменационную готовность. Для readiness используется только откалиброванная или проверенная оценка." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
