<UserControl x:Class="WortBruecke.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Прогресс LernType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,48" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Style="{StaticResource IconTile}">
                    <Path Width="22" Height="22" Data="{StaticResource Icon.Progress}" Fill="{DynamicResource Brush.AccentText}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,24,0">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="КУРС A0–A2 · НАВЫКИ · ПОВТОРЕНИЕ" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource HeroTitle}" FontSize="34" Text="Прогресс основного курса" />
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource BodySecondary}" Text="Основная шкала растёт только после завершённых уроков; упражнения и повторения показаны отдельно." />
                </StackPanel>
                <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Icon.Refresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Обновить" /></StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="26" Style="{StaticResource Panel}" AutomationProperties.Name="Очередь повторений">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="К ПОВТОРЕНИЮ" />
                            <Border Width="42" Height="42" HorizontalAlignment="Right" Style="{StaticResource IconTile}">
                                <Path Width="19" Height="19" Data="{StaticResource Icon.Refresh}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.8" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,12,0,20" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="46" FontWeight="SemiBold" Text="{Binding DueCount}" />
                            <TextBlock Margin="0,5,0,0" MaxWidth="520" Style="{StaticResource BodySecondary}" FontSize="13"
                                       Text="Карточки из интерактивных упражнений готовы к повторению и не меняют прогресс основного курса." />
                        </StackPanel>
                        <Button Grid.Row="2" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding StartReviewCommand}"
                                AutomationProperties.Name="Начать сессию с приоритетом повторений">
                            <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Начать повторение" /></StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Margin="0,0,0,9" Padding="17" Style="{StaticResource StatCard}">
                        <Grid><TextBlock Style="{StaticResource MetaText}" Text="ТЕКУЩИЙ КУРС" /><TextBlock HorizontalAlignment="Right" FontSize="23" FontWeight="SemiBold" Text="{Binding CurrentLevel}" /></Grid>
                    </Border>
                    <Border Margin="0,0,0,9" Padding="17" Style="{StaticResource StatCard}">
                        <Grid><TextBlock Style="{StaticResource MetaText}" Text="ПОПЫТОК ЗА 7 ДНЕЙ" /><TextBlock HorizontalAlignment="Right" FontSize="23" FontWeight="SemiBold" Text="{Binding WeekAttempts}" /></Grid>
                    </Border>
                    <Border Padding="17" Style="{StaticResource StatCard}">
                        <StackPanel><TextBlock Style="{StaticResource MetaText}" Text="ЗОНА ВНИМАНИЯ" /><TextBlock Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WeakestSkill}" /></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Padding="24" Style="{StaticResource Panel}"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Дополнительная статистика навыков" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodySecondary}" Text="{Binding TotalAttempts, StringFormat={}{0} сохранённых заданий}" />
                    </Grid>
                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="238" MinHeight="116" Margin="0,0,12,12" Padding="16" Style="{StaticResource StatCard}" CornerRadius="{DynamicResource Radius.Card}">
                                    <StackPanel>
                                        <Grid><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold" Text="{Binding ScoreText}" /></Grid>
                                        <TextBlock Margin="0,9,0,0" Style="{StaticResource BodySecondary}" FontSize="12" TextWrapping="Wrap" Text="{Binding DetailText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Margin="0,10,0,0" Height="7" Minimum="0" Maximum="1" Value="{Binding OverallCompletion, Mode=OneWay}" AutomationProperties.Name="Общий прогресс учебного пути" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodySecondary}" FontSize="12" Text="{Binding CourseProgressText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Padding="28" Style="{StaticResource Panel}"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"
                    AutomationProperties.Name="Прогресс пока пуст">
                <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                    <Border Width="60" Height="60" Margin="0,0,0,18" HorizontalAlignment="Center" Style="{StaticResource IconTile}">
                        <Path Width="27" Height="27" Data="{StaticResource Icon.Progress}" Fill="{DynamicResource Brush.AccentText}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Начните первый урок A0" />
                    <TextBlock Margin="0,10,0,18" Style="{StaticResource BodySecondary}"
                               Text="После завершения урока здесь появится прогресс курса. Свободные упражнения останутся отдельной статистикой для разминки и повторения." />
                    <Button HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCoursesCommand}">
                        <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Открыть курс A0" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Margin="0,0,0,0" Padding="16" VerticalAlignment="Top" Background="{DynamicResource Brush.ErrorSoft}" CornerRadius="{DynamicResource Radius.Input}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
