<UserControl x:Class="WortBruecke.App.Views.LevelStudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Центр выбранного уровня немецкого языка">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="44,34,44,48" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="44" Height="44" Padding="0" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"
                        AutomationProperties.Name="Вернуться к учебному пути" Content="←" />
                <Border Grid.Column="1" Width="64" Height="64" Margin="18,0,18,0" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Accent}" CornerRadius="18">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.OnAccent}"
                               FontFamily="{DynamicResource Font.Display}" FontSize="23" FontWeight="Bold"
                               Text="{Binding LevelLabel}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="100,0,300,0">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}"
                               Text="ЦЕНТР УРОВНЯ" />
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" MaxWidth="680" Style="{StaticResource BodySecondary}"
                               FontSize="14" TextWrapping="Wrap" Text="{Binding Outcome}" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Обновить центр уровня"
                        Content="Обновить" />
            </Grid>

            <Border Grid.Row="2" Padding="22" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,30,0">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Прогресс обязательных модулей" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ProgressText}" />
                        </Grid>
                        <ProgressBar Margin="0,13,0,0" Height="7" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     AutomationProperties.Name="Прогресс выбранного уровня" />
                        <TextBlock Margin="0,11,0,0" Style="{StaticResource BodySecondary}" FontSize="12"
                                   TextWrapping="Wrap" Text="{Binding ContinueHint}" />
                    </StackPanel>
                    <Button Grid.Column="1" MinHeight="48" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}"
                            AutomationProperties.Name="Продолжить первый неосвоенный модуль уровня"
                            Content="{Binding ContinueButtonText}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <Border Margin="0,0,0,16" Padding="14,11"
                        Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Input}"
                        Visibility="{Binding HasUnavailableModules, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"
                               Text="{Binding AvailabilityText}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="535" MinHeight="218" Margin="0,0,14,14" Padding="20"
                                    Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Margin="0,0,132,0" FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="19" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <Border HorizontalAlignment="Right" Padding="9,4"
                                                Background="{DynamicResource Brush.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Pill}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,12,0,17">
                                        <TextBlock Style="{StaticResource BodySecondary}" FontSize="13"
                                                   TextWrapping="Wrap" Text="{Binding Description}" />
                                        <Grid Margin="0,12,0,0">
                                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                                                       Text="{Binding ProgressText}" />
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       FontSize="12" Text="{Binding ContentText}" />
                                        </Grid>
                                        <ProgressBar Margin="0,9,0,0" Height="5" Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                                     Visibility="{Binding IsPublished, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.Warning}" FontSize="11"
                                                   Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibility}}"
                                                   Text="Дополнительный модуль: не блокирует прохождение уровня" />
                                    </StackPanel>

                                    <Button Grid.Row="2" MinHeight="42" HorizontalAlignment="Stretch"
                                            Style="{StaticResource SecondaryButton}" Command="{Binding LaunchCommand}"
                                            IsEnabled="{Binding IsAvailable}"
                                            AutomationProperties.Name="{Binding AutomationName}" Content="Открыть модуль" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
