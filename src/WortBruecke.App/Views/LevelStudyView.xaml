<UserControl x:Class="WortBruecke.App.Views.LevelStudyView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WortBruecke.Core.Models;assembly=WortBruecke.Core"
             AutomationProperties.Name="Центр выбранного уровня немецкого языка">
    <UserControl.Resources>
        <Style x:Key="LevelModulesList" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;1030}" Value="Visible">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelModuleIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Data" Value="{StaticResource Icon.Document}" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}" />
            <Setter Property="StrokeThickness" Value="1.55" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.WordGermanToRussian}">
                    <Setter Property="Data" Value="{StaticResource Icon.Word}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.WordRussianToGerman}">
                    <Setter Property="Data" Value="{StaticResource Icon.Word}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.SentenceGermanToRussian}">
                    <Setter Property="Data" Value="{StaticResource Icon.Sentence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.SentenceRussianToGerman}">
                    <Setter Property="Data" Value="{StaticResource Icon.Sentence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.Grammar}">
                    <Setter Property="Data" Value="{StaticResource Icon.Grammar}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LevelModuleKind.Audio}">
                    <Setter Property="Data" Value="{StaticResource Icon.Audio}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelContinueButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;850}" Value="Visible">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="Margin" Value="0,18,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,32,22,48" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Width="44" Height="44" Padding="0" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"
                        AutomationProperties.Name="Вернуться к учебному пути" ToolTip="Вернуться к учебному пути">
                    <Path Width="18" Height="18" Data="{StaticResource Icon.ChevronLeft}"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                </Button>

                <Border Grid.Column="1" Width="68" Height="68" Margin="16,0,18,0" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Accent}" BorderBrush="{DynamicResource Brush.GlassStroke}"
                        BorderThickness="1" CornerRadius="20" Effect="{DynamicResource Elevation.Raised}">
                    <Grid>
                        <Path Width="34" Height="34" Data="{StaticResource Icon.Route}" Stroke="{DynamicResource Brush.OnAccent}"
                              StrokeThickness="1.25" Opacity="0.22" Stretch="Uniform" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}"
                                   FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Text="{Binding LevelLabel}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="0,0,22,0">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ЦЕНТР УРОВНЯ" />
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitle}" FontSize="33" LineHeight="40" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" MaxWidth="680" Style="{StaticResource BodySecondary}"
                               FontSize="14" LineHeight="22" TextWrapping="Wrap" Text="{Binding Outcome}" />
                </StackPanel>

                <Button Grid.Column="3" MinWidth="118" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Обновить центр уровня">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Icon.Refresh}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.65" Stretch="Uniform" />
                        <TextBlock Style="{StaticResource ButtonContentText}" Text="Обновить" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Padding="24,22" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="310" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;850}" Value="Visible">
                                            <Setter Property="Width" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="14">
                        <Path Width="23" Height="23" Data="{StaticResource Icon.Progress}" Stroke="{DynamicResource Brush.AccentText}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="19" TextWrapping="Wrap"
                                       Text="Прогресс обязательных модулей" />
                            <Border Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="9,4" Background="{DynamicResource Brush.GlassInset}"
                                    BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="999">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ProgressText}" />
                            </Border>
                        </Grid>
                        <ProgressBar Margin="0,14,0,0" Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}" AutomationProperties.Name="Прогресс выбранного уровня" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Text="{Binding ContinueHint}" />
                    </StackPanel>
                    <Button Style="{StaticResource LevelContinueButton}"
                            Command="{Binding ContinueCommand}" AutomationProperties.Name="Продолжить первый неосвоенный модуль уровня">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ButtonContentText}" VerticalAlignment="Center" Text="{Binding ContinueButtonText}" />
                            <Path Grid.Column="1" Width="17" Height="17" Margin="11,0,0,0" Data="{StaticResource Icon.ArrowRight}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <Border Margin="0,0,14,18" Padding="14,12" Style="{StaticResource GlassInset}" CornerRadius="14"
                        Visibility="{Binding HasUnavailableModules, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold" Text="!" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12" LineHeight="18" TextWrapping="Wrap" Text="{Binding AvailabilityText}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Modules}" Style="{StaticResource LevelModulesList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="226" Margin="0,0,14,14" Padding="21" Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Margin="0,0,13,0" Background="{DynamicResource Brush.GlassInset}"
                                                BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="12">
                                            <Path Style="{StaticResource LevelModuleIcon}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <Border Grid.Column="2" Margin="10,0,0,0" Padding="9,4" VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.GlassInset}" BorderBrush="{DynamicResource Brush.GlassStroke}"
                                                BorderThickness="1" CornerRadius="999">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,14,0,17">
                                        <TextBlock Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="{Binding Description}" />
                                        <Grid Margin="0,13,0,0">
                                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Text="{Binding ProgressText}" />
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding ContentText}" />
                                        </Grid>
                                        <ProgressBar Margin="0,9,0,0" Height="5" Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                                     Visibility="{Binding IsPublished, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Margin="0,9,0,0" Padding="9,6" HorizontalAlignment="Left" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="8"
                                                Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Foreground="{DynamicResource Brush.Warning}" FontSize="10" Text="Дополнительный модуль · не блокирует уровень" />
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Row="2" MinHeight="44" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding LaunchCommand}" IsEnabled="{Binding IsAvailable}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Открыть модуль" />
                                            <Path Grid.Column="1" Width="16" Height="16" Margin="10,0,0,0" Data="{StaticResource Icon.ArrowRight}"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
