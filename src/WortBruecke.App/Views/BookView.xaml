<UserControl x:Class="WortBruecke.App.Views.BookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown"
             AutomationProperties.Name="Моя книга">
    <Grid Margin="44,32,44,44">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" Style="{StaticResource IconTile}"><Path Width="22" Height="22" Data="{StaticResource Icon.Book}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.8" Stretch="Uniform" /></Border>
            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ЛИЧНАЯ БИБЛИОТЕКА" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource PageTitle}" Text="Книга становится тренировкой" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                        Visibility="{Binding IsPractising, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ProgressText}" />
                <ProgressBar Width="170" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Border MaxWidth="1040" HorizontalAlignment="Stretch" Padding="32" Style="{StaticResource Panel}"
                        Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaText}" Text="НОВЫЙ ТЕКСТ" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionTitle}" FontSize="27" Text="Вставьте интересный отрывок" />
                            <TextBlock Margin="0,9,0,0" Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                                       Text="Например, главу из «Одиссеи», «Илиады» или немецкой книги. Текст остаётся только на этом компьютере." />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Padding="0" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Название · обязательно" Target="{Binding ElementName=BookTitleBox}" />
                                    <TextBox x:Name="BookTitleBox" IsEnabled="{Binding IsNotAnalyzing}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название книги" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Padding="0" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Язык текста" Target="{Binding ElementName=LanguageSelector}" />
                                    <ComboBox x:Name="LanguageSelector" IsEnabled="{Binding IsNotAnalyzing}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="Язык книги">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" /></StackPanel></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,17,0,6">
                                <Label Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Текст книги · обязательно" Target="{Binding ElementName=BookTextBox}" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding CharacterCount}" />
                            </Grid>
                            <TextBox x:Name="BookTextBox" IsEnabled="{Binding IsNotAnalyzing}" MinHeight="120" MaxHeight="260" MaxLength="500000" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding BookText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Текст книги" />

                            <Button Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}"
                                    Visibility="{Binding IsNotAnalyzing, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Извлечь слова из книги">
                                <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Margin="0,0,9,0" Data="{StaticResource Icon.Spark}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Извлечь слова локально" /></StackPanel>
                            </Button>
                            <Button Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding CancelOperationCommand}"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" Content="Отменить обработку" />
                            <Border Margin="0,10,0,0" Padding="14" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Input}">
                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" LineHeight="19" Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                            <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.InfoSoft}" CornerRadius="{DynamicResource Radius.Input}"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal"><ProgressBar Width="90" IsIndeterminate="True" /><TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Info}" Text="Анализируем без сети…" /></StackPanel>
                            </Border>

                            <StackPanel Margin="0,24,0,0" Visibility="{Binding HasVocabulary, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="21" Text="Слова для тренировки" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="СНИМИТЕ ФЛАЖОК, ЧТОБЫ ИСКЛЮЧИТЬ" />
                                </Grid>
                                <ListBox Margin="0,10,0,0" MaxHeight="280" ItemsSource="{Binding Words}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource Brush.GlassStandard}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="{Binding IsSelected}"
                                                              AutomationProperties.Name="{Binding Source, StringFormat=Выбрать слово: {0}}" />
                                                    <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Source}" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Text="{Binding Translation}" TextWrapping="Wrap" /></StackPanel>
                                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding Meta}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Margin="0,13,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding StartPracticeCommand}">
                                    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Начать тренировку по выбранным словам" /></StackPanel>
                                </Button>
                                <TextBlock Margin="0,13,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" LineHeight="18"
                                           Text="{Binding DraftPrivacyNote}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="11"
                                           Text="{Binding ProvenanceNote}" TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveBookCommand}"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.Check}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Сохранить локально" /></StackPanel></Button>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding ExportBookCommand}"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.Export}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Экспортировать" /></StackPanel></Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Padding="22" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}">
                                <StackPanel>
                                    <Border Width="48" Height="48" HorizontalAlignment="Left" Style="{StaticResource IconTile}"><Path Width="22" Height="22" Data="{StaticResource Icon.Book}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.8" Stretch="Uniform" /></Border>
                                    <TextBlock Margin="0,18,0,0" Style="{StaticResource SectionTitle}" FontSize="21" Text="Как это работает" />
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                               Text="1. Частотные словоформы извлекаются из текста.&#x0a;2. Приложение сверяет их с локальным словарём.&#x0a;3. Вы выбираете слова и переводите их." />
                                    <Border Margin="0,18,0,0" Padding="12" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="{DynamicResource Radius.Input}">
                                        <TextBlock Foreground="{DynamicResource Brush.Warning}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                   Text="Литературные падежи и спряжения иногда не совпадают со словарной формой. Такие слова честно пропускаются." />
                                    </Border>
                                    <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="11" Text="{Binding DictionaryNote}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasRecentBooks, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource MetaText}" Text="НЕДАВНИЕ КНИГИ" />
                                <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding RecentBooks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                                <Button Padding="13" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding VocabularyCount, StringFormat={}{0} слов}" /></StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource CompactIconButton}"
                                                        Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Удалить сохранённую книгу"><Path Width="17" Height="17" Data="{StaticResource Icon.Trash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /></Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,5,0,0" Style="{StaticResource DangerButton}" Command="{Binding RequestDeleteAllCommand}"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.Trash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Очистить библиотеку" /></StackPanel></Button>
                            </StackPanel>
                            <Border Margin="0,12,0,0" Padding="13" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="{DynamicResource Radius.Input}"
                                    Visibility="{Binding HasPendingDeletion, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource Brush.Warning}" FontSize="12" TextWrapping="Wrap" Text="{Binding DeletionPrompt}" />
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteCommand}" Content="Оставить" />
                                        <Button Grid.Column="2" Style="{StaticResource DangerButton}" Command="{Binding ConfirmDeleteCommand}" Content="Удалить" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding NewBookCommand}"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.Add}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Новый текст" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border MaxWidth="820" HorizontalAlignment="Stretch" Padding="38" Style="{StaticResource Panel}"
                        Visibility="{Binding IsPractising, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Border HorizontalAlignment="Left" Style="{StaticResource StatusPill}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding Title}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MetaText}" Text="{Binding ProgressText}" />
                        </Grid>
                        <Border Margin="0,26,0,0" Padding="28" MinHeight="190" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PromptInstruction}" />
                                <TextBlock Margin="0,12,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="38" FontWeight="SemiBold" Text="{Binding Prompt}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" FontStyle="Italic" LineHeight="20" Text="{Binding Context}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Label Margin="0,20,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="{Binding InputLabel}" Target="{Binding ElementName=BookAnswerBox}" />
                        <TextBox x:Name="BookAnswerBox" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Перевод слова из книги" />
                        <StackPanel Margin="0,9,0,0" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding ShowGermanCharacters, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Немецкие знаки" />
                            <Button Width="44" Height="44" Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ä" Content="ä" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ö" Content="ö" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ü" Content="ü" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ß" Content="ß" Click="OnGermanCharacterClicked" />
                        </StackPanel>
                        <Border Margin="0,13,0,0" Padding="14" Background="{DynamicResource Brush.GlassStandard}" BorderBrush="{Binding IsCorrect, Converter={StaticResource StatusBrushConverter}}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}" Visibility="{Binding ShowFeedback, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel><TextBlock FontWeight="SemiBold" Foreground="{Binding IsCorrect, Converter={StaticResource StatusBrushConverter}}" Text="{Binding FeedbackTitle}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Text="{Binding FeedbackDetail}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Button Margin="0,17,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" Visibility="{Binding ShowFeedback, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Check}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить · Enter" /></StackPanel>
                        </Button>
                        <Button Margin="0,17,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" Visibility="{Binding ShowFeedback, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ButtonContentText}" Text="Следующее слово · Enter" /><Path Width="15" Height="15" Margin="9,0,0,0" Data="{StaticResource Icon.ChevronRight}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border MaxWidth="650" HorizontalAlignment="Center" Padding="48" Style="{StaticResource Panel}"
                        Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="20"><Path Width="30" Height="30" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2.2" /></Border>
                        <TextBlock Margin="0,22,0,0" Style="{StaticResource PageTitle}" Text="Книжная сессия завершена" />
                        <TextBlock Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" Text="{Binding CompletionTitle}" />
                        <TextBlock Margin="0,7,0,0" MaxWidth="460" Style="{StaticResource BodySecondary}" TextAlignment="Center" Text="{Binding CompletionDetail}" TextWrapping="Wrap" />
                        <Button Width="230" Margin="0,26,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding BackToBookCommand}" Content="Вернуться к словам" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
