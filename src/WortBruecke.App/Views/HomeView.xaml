<UserControl x:Class="WortBruecke.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Главное меню LernType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48,40,48,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="RU → DE · ЛОКАЛЬНАЯ ПРАКТИКА" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource HeroTitle}" Text="{Binding Greeting}" />
                <TextBlock Margin="0,12,0,0" MaxWidth="620" Style="{StaticResource BodySecondary}"
                           Text="LernType сохраняет прогресс локально, ведёт от A0 к C2 и подсказывает язык ввода на каждом шаге." />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="32" AutomationProperties.Name="Открыть учебный путь A0–C2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="56" Height="56" HorizontalAlignment="Left" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="16">
                            <Path Width="27" Height="27" Data="{StaticResource Icon.Route}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,30,0,36" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="30" Text="Ваш путь A0 → C2" />
                            <TextBlock Margin="0,12,0,0" MaxWidth="520" Style="{StaticResource BodySecondary}"
                                       Text="Семь этапов, семь языковых навыков и понятная готовность к выбранному официальному экзамену." />
                            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MetaText}" Text="7 ЭТАПОВ" />
                                <TextBlock Margin="20,0,0,0" Style="{StaticResource MetaText}" Text="A0–C2" />
                                <TextBlock Margin="20,0,0,0" Style="{StaticResource MetaText}" Text="ОФЛАЙН" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Row="2" Width="190" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenLearningPathCommand}" AutomationProperties.Name="Открыть учебный путь A0–C2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="Открыть мой путь" />
                                <Path Width="17" Height="17" Margin="10,0,0,0" Data="{StaticResource Icon.ArrowRight}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Другие режимы" />
                    <TextBlock Margin="0,6,0,12" Style="{StaticResource BodySecondary}" FontSize="13" Text="Продолжайте там, где язык нуждается в практике." />

                    <Button Margin="0,0,0,8" Padding="13" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenTextsCommand}" AutomationProperties.Name="Открыть тексты для набора">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Data="{StaticResource Icon.Document}" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.7" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Тексты" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="Перевод и чистый набор" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" />
                        </Grid>
                    </Button>

                    <Button Margin="0,0,0,8" Padding="13" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenBooksCommand}" AutomationProperties.Name="Открыть личную книгу">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Data="{StaticResource Icon.Document}" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.7" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Моя книга" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="Вставьте текст и учите его слова" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" />
                        </Grid>
                    </Button>

                    <Button Margin="0,0,0,8" Padding="13" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenGrammarCommand}" AutomationProperties.Name="Открыть грамматический пересказ">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Data="{StaticResource Icon.Edit}" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.7" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Грамматика" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="Пересказ по заданию" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" />
                        </Grid>
                    </Button>

                    <Button Margin="0,0,0,8" Padding="13" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenVocabularyTestCommand}" AutomationProperties.Name="Открыть словарный тест">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Data="{StaticResource Icon.Chart}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Тест слов" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="RU→DE и DE→RU без подсказок" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" />
                        </Grid>
                    </Button>

                    <Button Padding="13" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenTelcCommand}" AutomationProperties.Name="Открыть TELC-чекер">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Width="20" Height="20" Data="{StaticResource Icon.Chart}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="TELC-чекер" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Text="Оценка текста по CEFR" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="16" Height="16" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
