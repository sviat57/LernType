<UserControl x:Class="WortBruecke.App.Views.HomeView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Главный экран LernType"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <Style x:Key="LevelPreview" TargetType="Border" BasedOn="{StaticResource GlassInset}">
            <Setter Property="Width" Value="210" />
            <Setter Property="MinHeight" Value="142" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
        <StackPanel Margin="36,32,36,48" MaxWidth="1100" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}"
                               Text="НЕМЕЦКИЙ С НУЛЯ · ОФЛАЙН" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource HeroTitle}" Text="{Binding Greeting}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="15" LineHeight="23"
                               Text="Теперь LernType ведёт по последовательному курсу: короткая теория, письмо, чтение, говорение, правило и проверка — шаг за шагом." />
                </StackPanel>
                <Border Grid.Column="1" Margin="28,2,0,0" Padding="14,10" VerticalAlignment="Top"
                        Style="{StaticResource GlassInset}" CornerRadius="14"
                        Visibility="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=900}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,9,0" Fill="{DynamicResource Brush.Success}" />
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Контент хранится локально" />
                            <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="Без аккаунта и обязательной сети" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.48*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Border MinHeight="350" Padding="30" AutomationProperties.Name="Открыть основной курс немецкого">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Setter Property="Grid.Column" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;820}" Value="Visible">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="46" Margin="0,0,14,0" Background="{DynamicResource Brush.Accent}" CornerRadius="14">
                                    <Path Width="22" Height="22" Data="{StaticResource Icon.Route}" Stroke="{DynamicResource Brush.OnAccent}"
                                          StrokeThickness="1.8" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ОСНОВНОЙ МАРШРУТ" />
                                    <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="23" FontWeight="SemiBold" Text="Немецкий с нуля" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,22,0,0" MaxWidth="620" Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                       Text="24 оригинальных урока от A0 · Pre-A1 до A2. Каждый урок соединяет объяснение и активную практику, а итоговый экзамен находится внутри выбранного курса." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,24,0,24">
                            <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="7"><Path Width="11" Height="11" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" /></Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="Короткая теория и наглядные грамматические таблицы" />
                            </Grid>
                            <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="7"><Path Width="11" Height="11" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" /></Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="Письмо, чтение, аудирование и устный ответ в каждом уроке" />
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="7"><Path Width="11" Height="11" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" /></Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="Последовательный прогресс и внутренний экзамен LernType" />
                            </Grid>
                        </StackPanel>

                        <Button Grid.Row="2" MinWidth="190" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCoursesCommand}" AutomationProperties.Name="Открыть курсы">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Выбрать курс" />
                                <Path Width="16" Height="16" Margin="10,0,0,0" Data="{StaticResource Icon.ArrowRight}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" Stretch="Uniform" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Padding="24">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Grid.Column" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;820}" Value="Visible">
                                    <Setter Property="Grid.Row" Value="2" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetaText}" Text="СВОБОДНАЯ ПРАКТИКА" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource SectionTitle}" Text="Разминка отдельно" />
                        <TextBlock Margin="0,10,0,20" Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="20"
                                   Text="Слова, предложения, прописывание текстов и запись речи теперь собраны в одном дополнительном разделе и не прерывают урок." />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenInteractiveExercisesCommand}"
                                AutomationProperties.Name="Открыть интерактивные упражнения">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17" Height="17" Margin="0,0,9,0" Data="{StaticResource Icon.Cards}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Stretch="Uniform" />
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Интерактивные упражнения" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,9,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding OpenProgressCommand}"
                                AutomationProperties.Name="Открыть прогресс">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Посмотреть прогресс" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,30,0,0">
                <TextBlock Style="{StaticResource MetaText}" Text="ОПУБЛИКОВАННЫЕ КУРСЫ" />
                <TextBlock Margin="0,7,0,16" Style="{StaticResource SectionTitle}" Text="Первый законченный маршрут" />
                <WrapPanel>
                    <Border Style="{StaticResource LevelPreview}">
                        <StackPanel><TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="A0" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Pre-A1 · старт" /><TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="12" LineHeight="18" Text="Алфавит, знакомство, числа, семья, предметы и первые бытовые фразы." /><TextBlock Margin="0,12,0,0" Style="{StaticResource MetaText}" Text="8 УРОКОВ" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource LevelPreview}">
                        <StackPanel><TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="A1" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Базовое общение" /><TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="12" LineHeight="18" Text="Дом, город, еда, день, работа, здоровье и прошедшие события." /><TextBlock Margin="0,12,0,0" Style="{StaticResource MetaText}" Text="8 УРОКОВ" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource LevelPreview}">
                        <StackPanel><TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="A2" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Самостоятельность" /><TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="12" LineHeight="18" Text="Поездки, переезд, услуги, работа, здоровье и связная бытовая речь." /><TextBlock Margin="0,12,0,0" Style="{StaticResource MetaText}" Text="8 УРОКОВ" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource LevelPreview}" Opacity="0.72">
                        <StackPanel><TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.TextTertiary}" Text="B1–C2" /><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Следующие этапы" /><TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" FontSize="12" LineHeight="18" Text="Видны в каталоге как запланированные и не подменяются материалом другого уровня." /><TextBlock Margin="0,12,0,0" Style="{StaticResource MetaText}" Text="ГОТОВЯТСЯ" /></StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
