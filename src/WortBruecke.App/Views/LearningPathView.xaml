<UserControl x:Class="WortBruecke.App.Views.LearningPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Учебный путь от Pre-A1 до C2">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="44,34,44,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ПЕРСОНАЛЬНЫЙ МАРШРУТ" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitle}" Text="От первого слова до C2" />
                    <TextBlock Margin="0,9,0,0" Style="{StaticResource BodySecondary}" FontSize="14"
                               Text="Каждый этап объединяет лексику, грамматику, чтение, аудирование, письмо, говорение и медиацию. Пробелы показаны честно." />
                </StackPanel>
                <Border Grid.Column="1" Padding="18" Style="{StaticResource GlassInset}" CornerRadius="{DynamicResource Radius.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" Background="{DynamicResource Brush.Accent}" CornerRadius="16">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}"
                                       FontFamily="{DynamicResource Font.Display}" FontSize="24" FontWeight="Bold" Text="{Binding CurrentLevelText}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,1,0,0">
                            <TextBlock Style="{StaticResource MetaText}" Text="ТЕКУЩИЙ ЭТАП" />
                            <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding OverallProgressText}" />
                            <ProgressBar Margin="0,9,0,0" Height="6" Maximum="100" Value="{Binding OverallProgressValue, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="0,0,0,16" Padding="14,12" Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}">
                    <Grid>
                        <TextBlock Margin="0,0,120,0" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Text="{Binding CatalogStatusText}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="Обновить учебный путь" Content="Обновить" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="22">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                <Setter Property="Opacity" Value="0.82" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.AccentSoft}" CornerRadius="16">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}"
                                                   FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="Bold" Text="{Binding Level}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="0,0,26,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <Border Margin="12,1,0,0" Padding="9,4" VerticalAlignment="Center" Background="{DynamicResource Brush.Sunken}" CornerRadius="{DynamicResource Radius.Pill}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StateText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,7,0,0" MaxWidth="620" Style="{StaticResource BodySecondary}" FontSize="13" Text="{Binding Outcome}" />
                                        <ProgressBar Margin="0,14,0,0" Height="6" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Text="{Binding ProgressText}" />
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding ContentText}" />
                                        </Grid>
                                        <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource Brush.Warning}" FontSize="12" TextWrapping="Wrap"
                                                   Text="{Binding MissingSkillsText}" Visibility="{Binding HasMissingSkills, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Text="{Binding ExamText}" />
                                        <Button MinHeight="44" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPracticeCommand}"
                                                AutomationProperties.Name="Открыть практику уровня" Content="Практика уровня" />
                                        <Button Margin="0,8,0,0" MinHeight="44" Style="{StaticResource SecondaryButton}" Command="{Binding OpenExamCommand}"
                                                AutomationProperties.Name="Открыть экзамены уровня" Content="Форматы экзаменов" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
