<UserControl x:Class="WortBruecke.App.Views.LearningPathView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Учебный путь от Pre-A1 до C2">
    <UserControl.Resources>
        <Style x:Key="PathHeaderGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="PathStageCard" TargetType="Border" BasedOn="{StaticResource GlassInset}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Width" Value="292" />
            <Setter Property="Padding" Value="17" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;900}" Value="Visible">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Margin" Value="0,22,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PathLevelActions" TargetType="Border">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;920}" Value="Visible">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="0,18,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,32,36,48" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource PathHeaderGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Margin="0,0,11,0" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10">
                            <Path Width="17" Height="17" Data="{StaticResource Icon.Route}" Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ПЕРСОНАЛЬНЫЙ МАРШРУТ" />
                    </StackPanel>
                    <TextBlock Margin="0,13,0,0" Style="{StaticResource PageTitle}" FontSize="34" LineHeight="42" Text="От первого слова до C2" />
                    <TextBlock Margin="0,9,0,0" Style="{StaticResource BodySecondary}" FontSize="14" LineHeight="22"
                               Text="Каждый этап соединяет лексику, грамматику, чтение, аудирование, письмо, говорение и медиацию. Пробелы показаны честно." />
                </StackPanel>

                <Border Style="{StaticResource PathStageCard}" AutomationProperties.Name="Текущий этап учебного пути">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="62" Height="62" Background="{DynamicResource Brush.Accent}" CornerRadius="18">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}"
                                       FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="Bold" Text="{Binding CurrentLevelText}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,1,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetaText}" Text="ТЕКУЩИЙ ЭТАП" />
                            <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Text="{Binding OverallProgressText}" />
                            <ProgressBar Margin="0,10,0,0" Height="5" Maximum="100" Value="{Binding OverallProgressValue, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <Border Margin="0,0,0,18" Padding="15,12" Style="{StaticResource GlassInset}" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="9">
                            <Path Width="14" Height="14" Data="{StaticResource Icon.Progress}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.45" Stretch="Uniform" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12" TextWrapping="Wrap" Text="{Binding CatalogStatusText}" />
                        <Button Grid.Column="2" MinWidth="112" Padding="13,8" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="Обновить учебный путь">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Обновить" />
                                <Path Width="15" Height="15" Margin="8,0,0,0" Data="{StaticResource Icon.Refresh}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.65" Stretch="Uniform" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14" Padding="22,20">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                <Setter Property="Opacity" Value="0.78" />
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition>
                                            <ColumnDefinition.Style>
                                                <Style TargetType="ColumnDefinition">
                                                    <Setter Property="Width" Value="216" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;920}" Value="Visible">
                                                            <Setter Property="Width" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ColumnDefinition.Style>
                                        </ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Border Width="2" Margin="27,55,0,-20" HorizontalAlignment="Left" Background="{DynamicResource Brush.BorderSubtle}" />
                                        <Border Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.GlassStroke}"
                                                BorderThickness="1" CornerRadius="17">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}"
                                                       FontFamily="{DynamicResource Font.Display}" FontSize="19" FontWeight="Bold" Text="{Binding Level}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="0,0,28,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <Border Margin="12,1,0,0" Padding="9,4" VerticalAlignment="Center" Background="{DynamicResource Brush.GlassInset}"
                                                    BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="999">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StateText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,7,0,0" MaxWidth="620" Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="20" Text="{Binding Outcome}" />
                                        <ProgressBar Margin="0,15,0,0" Height="5" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Text="{Binding ProgressText}" />
                                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding ContentText}" />
                                        </Grid>
                                        <Border Margin="0,10,0,0" Padding="10,7" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="9"
                                                Visibility="{Binding HasMissingSkills, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Foreground="{DynamicResource Brush.Warning}" FontSize="11" TextWrapping="Wrap" Text="{Binding MissingSkillsText}" />
                                        </Border>
                                    </StackPanel>

                                    <Border Style="{StaticResource PathLevelActions}">
                                        <StackPanel>
                                            <TextBlock Margin="1,0,1,11" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" LineHeight="17" TextWrapping="Wrap" Text="{Binding ExamText}" />
                                            <Button MinHeight="44" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPracticeCommand}"
                                                    AutomationProperties.Name="{Binding PracticeAutomationName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Icon.Route}"
                                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" Stretch="Uniform" />
                                                    <TextBlock Style="{StaticResource ButtonContentText}" Text="Практика уровня" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,8,0,0" MinHeight="44" Style="{StaticResource SecondaryButton}" Command="{Binding OpenExamCommand}"
                                                    AutomationProperties.Name="{Binding ExamAutomationName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Icon.Certificate}"
                                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Stretch="Uniform" />
                                                    <TextBlock Style="{StaticResource ButtonContentText}" Text="Форматы экзаменов" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
