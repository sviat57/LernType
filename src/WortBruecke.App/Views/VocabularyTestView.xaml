<UserControl x:Class="WortBruecke.App.Views.VocabularyTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded"
             AutomationProperties.Name="Двусторонний словарный тест">
    <Grid Margin="48,36,48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="СЛОВАРНЫЙ ТЕСТ" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitle}" Text="Переводите в обе стороны" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                        Visibility="{Binding IsTestActive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding QuestionNumberText}" />
                <ProgressBar Width="170" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,4,0,8">
                <Border MaxWidth="900" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Style="{StaticResource Panel}"
                        Visibility="{Binding IsSelectionVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetaText}" Text="КОРОТКАЯ ПРОВЕРКА" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionTitle}" FontSize="28" Text="До 20 слов без подсказок" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}"
                                       Text="Вопросы делятся поровну между переводом RU→DE и DE→RU. Каждое слово встречается только один раз." />

                            <Label Margin="0,24,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="13" Content="Уровень CEFR" Target="{Binding ElementName=LevelSelector}" />
                            <ComboBox x:Name="LevelSelector"
                                      ItemsSource="{Binding Levels}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      AutomationProperties.Name="Уровень словарного теста">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="{Binding AvailableWordsText}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Результат только в конце" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Brush.Error}" FontSize="13" Text="{Binding SelectionMessage}" />
                            <Button Margin="0,20,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    AutomationProperties.Name="Начать двусторонний словарный тест">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding StartButtonText}" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="2" Padding="22" Style="{StaticResource GlassInset}">
                            <StackPanel VerticalAlignment="Center">
                                <Border Padding="18" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" Background="{DynamicResource Brush.GlassStrong}" CornerRadius="14">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="RU" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="RU → DE" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Вспомнить немецкое слово" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.GlassStandard}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" Background="{DynamicResource Brush.GlassStrong}" CornerRadius="14">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="DE" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="DE → RU" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Проверить понимание" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="2,18,2,0" Style="{StaticResource BodySecondary}" FontSize="13"
                                           Text="LernType автоматически меняет раскладку под язык ответа." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border MaxWidth="720" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Style="{StaticResource Panel}"
                        Visibility="{Binding IsTestActive, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="10,5" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding DirectionLabel}" />
                                </Border>
                                <Border Margin="8,0,0,0" Padding="10,5" Background="{DynamicResource Brush.GlassStandard}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedLevelLabel}" />
                                </Border>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="{Binding QuestionNumberText}" />
                        </Grid>

                        <Border Margin="0,26,0,0" MinHeight="190" Padding="28" Style="{StaticResource GlassInset}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding DirectionInstruction}" />
                                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           FontFamily="{DynamicResource Font.Display}" FontSize="40" FontWeight="SemiBold"
                                           Text="{Binding Prompt}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Label Margin="0,22,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13" Content="{Binding AnswerLanguageLabel}" Target="{Binding ElementName=AnswerBox}" />
                        <TextBox x:Name="AnswerBox" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Ответ на вопрос словарного теста" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12"
                                       Text="Без проверки до окончания теста" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                        Visibility="{Binding ShowGermanCharacterPanel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Немецкие знаки" />
                                <Button Width="42" Height="42" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ä" Content="ä" Click="OnGermanCharacterClicked" AutomationProperties.Name="Вставить ä" />
                                <Button Width="42" Height="42" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ö" Content="ö" Click="OnGermanCharacterClicked" AutomationProperties.Name="Вставить ö" />
                                <Button Width="42" Height="42" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ü" Content="ü" Click="OnGermanCharacterClicked" AutomationProperties.Name="Вставить ü" />
                                <Button Width="42" Height="42" Padding="0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ß" Content="ß" Click="OnGermanCharacterClicked" AutomationProperties.Name="Вставить ß" />
                            </StackPanel>
                        </Grid>

                        <Button Margin="0,18,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                                AutomationProperties.Name="Сохранить ответ и перейти к следующему вопросу">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Ответить и дальше · Enter" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border MaxWidth="900" Padding="40" HorizontalAlignment="Stretch"
                        Style="{StaticResource Panel}"
                        Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="20">
                                <Path Width="30" Height="30" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2.2" Stretch="Uniform" />
                            </Border>
                            <TextBlock Margin="0,22,0,0" HorizontalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding CompletionTitle}" />
                        </StackPanel>

                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="18" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ОБЩАЯ ТОЧНОСТЬ" />
                                    <TextBlock Margin="0,9,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding OverallResultText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="18" Style="{StaticResource GlassInset}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaText}" Text="RU → DE" />
                                    <TextBlock Margin="0,9,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding RussianToGermanResultText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Padding="18" Style="{StaticResource GlassInset}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaText}" Text="DE → RU" />
                                    <TextBlock Margin="0,9,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding GermanToRussianResultText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,20,0,0" Padding="20" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="{DynamicResource Radius.Card}"
                                Visibility="{Binding IsPerfectResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Success}" FontSize="16" FontWeight="SemiBold"
                                       Text="Все ответы верны — повторять пока нечего." />
                        </Border>

                        <StackPanel Margin="0,24,0,0" Visibility="{Binding HasMistakes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="21" Text="{Binding MistakesTitle}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource BodySecondary}" FontSize="13"
                                       Text="Правильные варианты показываются только сейчас, после завершения всех вопросов." />
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Mistakes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="16" Background="{DynamicResource Brush.GlassStandard}"
                                                BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="9,4" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding Direction}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Prompt}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.Error}" Text="{Binding SubmittedAnswer, StringFormat=Ваш ответ: {0}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Text="ПРАВИЛЬНО" />
                                                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" Text="{Binding ExpectedAnswer}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button Width="230" Margin="0,24,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RestartCommand}" Content="Пройти ещё один тест" AutomationProperties.Name="Начать новый словарный тест" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
