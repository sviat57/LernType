<UserControl x:Class="WortBruecke.App.Views.CoursePathView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Курсы немецкого LernType"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <Style x:Key="CourseSelectorButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="152" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Brush.GlassInset}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPublished}" Value="False">
                    <Setter Property="Opacity" Value="0.58" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LessonButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                    <Setter Property="Opacity" Value="0.52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,52" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" Margin="0,0,12,0" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="11">
                            <Path Width="18" Height="18" Data="{StaticResource Icon.Route}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.8" Stretch="Uniform" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ПОСЛЕДОВАТЕЛЬНЫЙ КУРС" />
                    </StackPanel>
                    <TextBlock Margin="0,13,0,0" Style="{StaticResource PageTitle}" FontSize="34" Text="{Binding TrackTitle}" />
                    <TextBlock Margin="0,9,0,0" Style="{StaticResource BodySecondary}" FontSize="14" LineHeight="22"
                               Text="Выберите уровень свободно, затем проходите уроки по порядку. Экзамен находится внутри курса и открывается только после всех контрольных шагов." />
                </StackPanel>
                <Button Grid.Column="1" Margin="24,0,0,0" MinWidth="112" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" AutomationProperties.Name="Обновить курсы">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonContentText}" Text="Обновить" />
                        <Path Width="15" Height="15" Margin="8,0,0,0" Data="{StaticResource Icon.Refresh}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Stretch="Uniform" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Margin="0,24,0,0" Padding="18,16" Style="{StaticResource GlassInset}" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="10">
                        <Path Width="15" Height="15" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MetaText}" Text="{Binding TrackMeta}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="0,26,0,12" Style="{StaticResource MetaText}" Text="ВЫБЕРИТЕ КУРС" />
            <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CourseSelectorButton}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsPublished}"
                                AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding LevelText}" />
                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}"
                                             Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding StateText}" />
                                </StackPanel>
                                <ProgressBar Grid.Row="2" Height="4" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,18,0,0" Padding="28" Style="{StaticResource Panel}" Visibility="{Binding HasSelectedCourse, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding SelectedCourseLevel}" />
                        <TextBlock Margin="0,7,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="27" FontWeight="SemiBold" Text="{Binding SelectedCourseTitle}" />
                        <TextBlock Margin="0,5,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedCourseSubtitle}" />
                        <TextBlock Margin="0,14,0,0" MaxWidth="680" Style="{StaticResource BodySecondary}" FontSize="13" LineHeight="21" Text="{Binding SelectedCourseOutcome}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="17" Style="{StaticResource GlassInset}" CornerRadius="16">
                        <StackPanel>
                            <Grid><TextBlock Style="{StaticResource MetaText}" Text="ПРОГРЕСС КУРСА" /><TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding CourseProgressText}" /></Grid>
                            <ProgressBar Margin="0,11,0,15" Height="6" Maximum="100" Value="{Binding CourseProgressValue, Mode=OneWay}" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" AutomationProperties.Name="{Binding ContinueButtonText}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding ContinueButtonText}" /><Path Width="15" Height="15" Margin="9,0,0,0" Data="{StaticResource Icon.ArrowRight}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Stretch="Uniform" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding Units}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16" Padding="22" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" HorizontalAlignment="Left" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="12">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding NumberText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="19" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource BodySecondary}" FontSize="12" Text="{Binding Outcome}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Lessons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,8" Style="{StaticResource LessonButton}" Command="{Binding OpenCommand}" IsEnabled="{Binding IsUnlocked}"
                                                    AutomationProperties.Name="{Binding AutomationName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" Background="{DynamicResource Brush.GlassStrong}" CornerRadius="11">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="{Binding NumberText}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,18,0">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Margin="0,4,0,0" MaxWidth="650" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Outcome}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource MetaText}" Text="{Binding MetaText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StatusText}" />
                                                        <Path Width="15" Height="15" Margin="0,8,0,0" HorizontalAlignment="Right" Data="{StaticResource Icon.ArrowRight}" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.7" Stretch="Uniform" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,6,0,0" Padding="24" Style="{StaticResource Panel}" AutomationProperties.Name="Итоговый экзамен выбранного курса">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="15">
                        <Path Width="23" Height="23" Data="{StaticResource Icon.Certificate}" Stroke="{DynamicResource Brush.AccentText}" StrokeThickness="1.6" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="15,0,24,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="18" FontWeight="SemiBold" Text="{Binding ExamTitle}" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource BodySecondary}" FontSize="12" Text="{Binding ExamStatusText}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MetaText}" Text="Внутренняя проверка · не является официальным сертификатом" />
                    </StackPanel>
                    <Button Grid.Column="2" MinWidth="150" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenExamCommand}" IsEnabled="{Binding IsExamUnlocked}" AutomationProperties.Name="Открыть внутренний экзамен">
                        <TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding ExamButtonText}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
