<UserControl x:Class="WortBruecke.App.Views.TextPracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown"
             AutomationProperties.Name="Тексты для набора">
    <Grid Margin="48,36,48,48">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ТЕКСТЫ ДЛЯ НАБОРА" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitle}" Text="Читайте, переводите, печатайте" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                        Visibility="{Binding IsPractising, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ProgressText}" />
                <ProgressBar Width="170" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,4,0,8">
                <Border MaxWidth="1040" Padding="38" HorizontalAlignment="Stretch" Style="{StaticResource Panel}"
                        Visibility="{Binding IsSelectionVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaText}" Text="ВЫБОР ТЕКСТА" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionTitle}" FontSize="27" Text="Настройте упражнение" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource BodySecondary}" Text="Фрагменты идут по порядку. Прогресс каждого текста сохраняется локально." />
                            <Border Margin="0,14,0,0" HorizontalAlignment="Left" Padding="10,5" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding FilterLabel}" />
                            </Border>

                            <Label Margin="0,22,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Текст" Target="{Binding ElementName=PassageSelector}" />
                            <ComboBox x:Name="PassageSelector" ItemsSource="{Binding Passages}" SelectedItem="{Binding SelectedPassage}" AutomationProperties.Name="Выберите текст">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Titles, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=ru-RU}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Level}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Label Margin="0,18,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Режим" Target="{Binding ElementName=ModeSelector}" />
                            <ListBox x:Name="ModeSelector" Style="{StaticResource DifficultyList}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Режим текста">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Margin="0,18,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" AutomationProperties.Name="Начать выбранный текст">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Начать текст" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="2" Padding="26" Background="{DynamicResource Brush.Sunken}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel VerticalAlignment="Stretch">
                                <Grid>
                                    <Path Width="38" Height="38" HorizontalAlignment="Left" Data="{StaticResource Icon.Document}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" Stretch="Uniform" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="ПРЕДВАРИТЕЛЬНОЕ ЧТЕНИЕ" />
                                </Grid>
                                <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionTitle}" Text="{Binding SelectedPassageTitle}" />
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedPassageMeta}" />

                                <TextBlock Margin="0,22,0,0" Style="{StaticResource MetaText}" Text="НЕМЕЦКИЙ ТЕКСТ" />
                                <Border Margin="0,8,0,0" Padding="14" Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.Input}">
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock FontSize="15" LineHeight="23" TextWrapping="Wrap" Text="{Binding FullGermanText}" />
                                    </ScrollViewer>
                                </Border>

                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleRussianPreviewCommand}" Content="{Binding RussianPreviewToggleText}"
                                        AutomationProperties.Name="Показать или скрыть русский перевод" />
                                <Border Margin="0,10,0,0" Padding="14" Background="{DynamicResource Brush.Raised}" CornerRadius="{DynamicResource Radius.Input}"
                                        Visibility="{Binding IsRussianPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MetaText}" Text="РУССКИЙ ПЕРЕВОД" />
                                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14" LineHeight="22" TextWrapping="Wrap" Text="{Binding FullRussianText}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" TextWrapping="Wrap"
                                           Text="Предварительное чтение не создаёт попытку и не изменяет прогресс. Немецкая раскладка включится перед первым полем ввода." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border MaxWidth="860" Padding="36" HorizontalAlignment="Stretch" Style="{StaticResource Panel}"
                        Visibility="{Binding IsPractising, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="10,5" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Pill}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding SelectedPassageTitle}" />
                                </Border>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="{Binding SelectedPassageMeta}" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="{Binding ProgressText}" />
                        </Grid>

                        <Border Margin="0,24,0,0" Padding="26" Background="{DynamicResource Brush.Sunken}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetaText}" Text="{Binding SourceLabel}" />
                                <TextBlock Margin="0,13,0,0" FontSize="20" LineHeight="31" TextWrapping="Wrap" Text="{Binding SourceText}" />
                            </StackPanel>
                        </Border>

                        <Label Margin="0,20,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="{Binding InputLabel}" Target="{Binding ElementName=TextAnswerBox}" />
                        <TextBox x:Name="TextAnswerBox" MinHeight="112" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Немецкий текст ответа" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Немецкие знаки" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" FontSize="17" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ä" Content="ä" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" FontSize="17" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ö" Content="ö" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" FontSize="17" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ü" Content="ü" Click="OnGermanCharacterClicked" />
                            <Button Width="44" Height="44" Padding="0" Style="{StaticResource SecondaryButton}" FontSize="17" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ß" Content="ß" Click="OnGermanCharacterClicked" />
                        </StackPanel>

                        <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource Brush.Raised}"
                                BorderBrush="{Binding IsCorrect, Converter={StaticResource StatusBrushConverter}}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Input}"
                                Visibility="{Binding ShowFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding IsCorrect, Converter={StaticResource StatusBrushConverter}}" Text="{Binding FeedbackTitle}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Text="{Binding FeedbackDetail}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Width="130" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousCommand}" Content="Назад" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}"
                                    Visibility="{Binding ShowFeedback, Converter={StaticResource InverseBoolToVisibility}}" AutomationProperties.Name="Проверить текст">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить · Ctrl+Enter" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}"
                                    Visibility="{Binding ShowFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Следующий фрагмент">
                                <TextBlock Style="{StaticResource ButtonContentText}" Text="Следующий фрагмент" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border MaxWidth="650" Padding="48" HorizontalAlignment="Center" Style="{StaticResource Panel}"
                        Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="20">
                            <Path Width="30" Height="30" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2.2" />
                        </Border>
                        <TextBlock Margin="0,22,0,0" Style="{StaticResource PageTitle}" Text="Текст завершён" />
                        <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding CompletionTitle}" />
                        <Button Width="210" Margin="0,28,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding RestartCommand}" Content="Выбрать другой текст" />
                        <Button MinWidth="230" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ReturnToLevelCommand}"
                                Visibility="{Binding HasLevelContext, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Вернуться в центр уровня">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="{Binding ReturnToLevelText}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
