<UserControl x:Class="WortBruecke.App.Views.GrammarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded"
             AutomationProperties.Name="Грамматический пересказ">
    <Grid Margin="40,32,40,44">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" Margin="0,0,16,0" Style="{StaticResource IconTile}" VerticalAlignment="Center">
                    <Path Width="25" Height="25" Data="{StaticResource Icon.Grammar}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ГРАММАТИЧЕСКИЙ ПЕРЕСКАЗ" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource PageTitle}" Text="Меняйте форму, сохраняя смысл" />
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReturnToLevelCommand}"
                    Visibility="{Binding HasLevelContext, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.ChevronLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" /><TextBlock Text="{Binding ReturnToLevelText}" /></StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="980" Padding="34" HorizontalAlignment="Stretch" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;980}" Value="Visible"><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers></Style>
                            </StackPanel.Style>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Border Width="38" Height="38" Margin="0,0,11,0" Style="{StaticResource IconTile}">
                                    <Path Width="18" Height="18" Data="{StaticResource Icon.Spark}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ШАГ 1" /><TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="Выберите преобразование" /></StackPanel>
                            </StackPanel>
                            <Label Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Задание" Target="{Binding ElementName=TaskSelector}" />
                            <ComboBox x:Name="TaskSelector" Margin="0,6,0,0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="Грамматическое задание">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Instructions, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=ru-RU}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Level}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Margin="0,18,0,0" Padding="20" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Width="20" Height="20" VerticalAlignment="Top" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" Stretch="Uniform" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ЧТО НУЖНО СДЕЛАТЬ" />
                                        <TextBlock Margin="0,9,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Instruction}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Padding="22" CornerRadius="{DynamicResource Radius.Card}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource GlassInset}"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="2" /><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=&lt;980}" Value="Visible"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,20,0,0" /></DataTrigger></Style.Triggers></Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" Margin="0,0,10,0" Style="{StaticResource IconTile}" CornerRadius="8"><Path Width="15" Height="15" Data="{StaticResource Icon.Document}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" /></Border>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaText}" Text="ИСХОДНЫЙ ТЕКСТ" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="10,5" Style="{StaticResource StatusPill}"><TextBlock Style="{StaticResource MetaText}" Text="{Binding LevelLabel}" /></Border>
                                </Grid>
                                <TextBlock Margin="0,13,0,0" FontSize="18" LineHeight="28" TextWrapping="Wrap" Text="{Binding SourceText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
                        <Border Width="34" Height="34" Margin="0,0,10,0" Style="{StaticResource IconTile}" CornerRadius="9"><Path Width="16" Height="16" Data="{StaticResource Icon.Edit}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7" Stretch="Uniform" /></Border>
                        <Label Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Ваш пересказ по-немецки" Target="{Binding ElementName=GrammarAnswerBox}" />
                    </StackPanel>
                    <TextBox x:Name="GrammarAnswerBox" MinHeight="150" MaxLength="12000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Текст грамматического пересказа" />

                    <WrapPanel Margin="0,10,0,0">
                        <Border Padding="12,8" HorizontalAlignment="Left" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}">
                            <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Info}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Info}" Text="Эвристика проверяет маркеры, но не оценивает весь смысл" /></StackPanel>
                        </Border>
                        <StackPanel Margin="12,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Немецкие знаки" />
                            <Button Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ä" Content="ä" />
                            <Button Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ö" Content="ö" />
                            <Button Margin="0,0,6,0" Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ü" Content="ü" />
                            <Button Style="{StaticResource CharacterButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ß" Content="ß" />
                        </StackPanel>
                    </WrapPanel>

                    <Border Margin="0,16,0,0" Padding="20" Background="{DynamicResource Brush.Raised}"
                            BorderBrush="{Binding HasExpectedMarkers, Converter={StaticResource StatusBrushConverter}}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}"
                            Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Margin="0,0,11,0" Style="{StaticResource IconTile}" CornerRadius="9"><Path Width="16" Height="16" Data="{StaticResource Icon.Check}" Stroke="{Binding HasExpectedMarkers, Converter={StaticResource StatusBrushConverter}}" StrokeThickness="2" Stretch="Uniform" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{Binding HasExpectedMarkers, Converter={StaticResource StatusBrushConverter}}" Text="Результат офлайн-проверки" /><TextBlock Margin="0,3,0,0" Style="{StaticResource BodySecondary}" FontSize="14" Text="{Binding FeedbackSummary}" /></StackPanel>
                            </StackPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Найдены" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding FoundMarkers}">
                                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3" Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2" Stretch="Uniform" /><TextBlock Foreground="{DynamicResource Brush.Success}" Text="{Binding}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="Стоит добавить" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding MissingMarkers}">
                                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3" Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource Brush.Error}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Foreground="{DynamicResource Brush.Error}" Text="{Binding}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="18" Background="{DynamicResource Brush.InfoSoft}" CornerRadius="{DynamicResource Radius.Card}"
                            Visibility="{Binding HasOnlineFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Margin="0,0,9,0" Data="{StaticResource Icon.Analyze}" Stroke="{DynamicResource Brush.Info}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Info}" Text="Расширенный разбор" /></StackPanel>
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Text="{Binding OnlineFeedback}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding OnlineError}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" AutomationProperties.Name="Проверить грамматический пересказ">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Check}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" /><TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить маркеры · Ctrl+Enter" /></StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding OnlineCheckCommand}" AutomationProperties.Name="Расширенный разбор грамматики"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,9,0" Data="{StaticResource Icon.Analyze}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" /><TextBlock Text="Расширенный разбор через API" /></StackPanel></Button>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
