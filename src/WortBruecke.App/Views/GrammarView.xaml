<UserControl x:Class="WortBruecke.App.Views.GrammarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded"
             AutomationProperties.Name="Грамматический пересказ">
    <Grid Margin="48,36,48,48">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ГРАММАТИЧЕСКИЙ ПЕРЕСКАЗ" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource PageTitle}" Text="Меняйте форму, сохраняя смысл" />
            </StackPanel>
            <Button Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReturnToLevelCommand}" Content="{Binding ReturnToLevelText}"
                    Visibility="{Binding HasLevelContext, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="900" Padding="36" HorizontalAlignment="Stretch" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Задание" Target="{Binding ElementName=TaskSelector}" />
                            <ComboBox x:Name="TaskSelector" Margin="0,6,0,0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="Грамматическое задание">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Instructions, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=ru-RU}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Level}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Margin="0,18,0,0" Padding="20" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ЧТО НУЖНО СДЕЛАТЬ" />
                                    <TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Instruction}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" Padding="22" Background="{DynamicResource Brush.Sunken}" CornerRadius="{DynamicResource Radius.Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource MetaText}" Text="ИСХОДНЫЙ ТЕКСТ" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MetaText}" Text="{Binding LevelLabel}" />
                                </Grid>
                                <TextBlock Margin="0,13,0,0" FontSize="18" LineHeight="28" TextWrapping="Wrap" Text="{Binding SourceText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Label Margin="0,22,0,6" Padding="0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Content="Ваш пересказ по-немецки" Target="{Binding ElementName=GrammarAnswerBox}" />
                    <TextBox x:Name="GrammarAnswerBox" MinHeight="150" MaxLength="12000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Текст грамматического пересказа" />

                    <Grid Margin="0,10,0,0">
                        <Border Padding="11,7" HorizontalAlignment="Left" Background="{DynamicResource Brush.InfoSoft}" CornerRadius="{DynamicResource Radius.Pill}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Info}" Text="Эвристика проверяет маркеры, но не оценивает весь смысл" />
                        </Border>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" Text="Немецкие знаки" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ä" Content="ä" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ö" Content="ö" />
                            <Button Width="44" Height="44" Padding="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ü" Content="ü" />
                            <Button Width="44" Height="44" Padding="0" Style="{StaticResource SecondaryButton}" Command="{Binding InsertGermanCharacterCommand}" CommandParameter="ß" Content="ß" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="20" Background="{DynamicResource Brush.Raised}"
                            BorderBrush="{Binding HasExpectedMarkers, Converter={StaticResource StatusBrushConverter}}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}"
                            Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{Binding HasExpectedMarkers, Converter={StaticResource StatusBrushConverter}}" Text="Результат офлайн-проверки" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource BodySecondary}" FontSize="14" Text="{Binding FeedbackSummary}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Найдены" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding FoundMarkers}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" Foreground="{DynamicResource Brush.Success}" Text="{Binding StringFormat=✓ {0}}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Text="Стоит добавить" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding MissingMarkers}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" Foreground="{DynamicResource Brush.Error}" Text="{Binding StringFormat=— {0}}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="18" Background="{DynamicResource Brush.InfoSoft}" CornerRadius="{DynamicResource Radius.Card}"
                            Visibility="{Binding HasOnlineFeedback, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Info}" Text="Расширенный разбор" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Text="{Binding OnlineFeedback}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding OnlineError}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" AutomationProperties.Name="Проверить грамматический пересказ">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить маркеры · Ctrl+Enter" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding OnlineCheckCommand}" Content="Расширенный разбор через API" AutomationProperties.Name="Расширенный разбор грамматики" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
