<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Primitive geometry, typography, space and motion. Semantic colors are theme-owned. -->

    <sys:Double x:Key="Space.2XS">2</sys:Double>
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.SM">8</sys:Double>
    <sys:Double x:Key="Space.MD">16</sys:Double>
    <sys:Double x:Key="Space.LG">24</sys:Double>
    <sys:Double x:Key="Space.XL">32</sys:Double>
    <sys:Double x:Key="Space.2XL">48</sys:Double>
    <sys:Double x:Key="Space.3XL">64</sys:Double>
    <sys:Double x:Key="Space.4XL">96</sys:Double>

    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Type.2XS">11</sys:Double>
    <sys:Double x:Key="Type.XS">12</sys:Double>
    <sys:Double x:Key="Type.SM">14</sys:Double>
    <sys:Double x:Key="Type.Base">16</sys:Double>
    <sys:Double x:Key="Type.LG">18</sys:Double>
    <sys:Double x:Key="Type.XL">22</sys:Double>
    <sys:Double x:Key="Type.2XL">30</sys:Double>
    <sys:Double x:Key="Type.3XL">42</sys:Double>
    <sys:Double x:Key="Type.4XL">52</sys:Double>

    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Input">10</CornerRadius>
    <CornerRadius x:Key="Radius.Button">12</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">14</CornerRadius>
    <CornerRadius x:Key="Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">24</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">28</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <sys:Double x:Key="Control.Target">44</sys:Double>
    <sys:Double x:Key="Control.TargetLarge">52</sys:Double>
    <sys:Double x:Key="Icon.Small">16</sys:Double>
    <sys:Double x:Key="Icon.Standard">20</sys:Double>
    <sys:Double x:Key="Icon.Large">24</sys:Double>

    <!-- The gradient stroke is the direct-light layer; these effects provide ambient depth. -->
    <DropShadowEffect x:Key="Elevation.Control" x:Shared="False" BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="{DynamicResource Color.Shadow}" />
    <DropShadowEffect x:Key="Elevation.Raised" x:Shared="False" BlurRadius="26" ShadowDepth="3" Opacity="0.13" Color="{DynamicResource Color.Shadow}" />
    <DropShadowEffect x:Key="Elevation.Hover" x:Shared="False" BlurRadius="30" ShadowDepth="5" Opacity="0.17" Color="{DynamicResource Color.Shadow}" />
    <DropShadowEffect x:Key="Elevation.Overlay" x:Shared="False" BlurRadius="42" ShadowDepth="10" Opacity="0.20" Color="{DynamicResource Color.Shadow}" />

    <!-- Motion intensity 3/10: interaction acknowledgement only. -->
    <Duration x:Key="Motion.Instant">0:0:0.08</Duration>
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.15</Duration>

    <sys:Int32 x:Key="Z.Base">0</sys:Int32>
    <sys:Int32 x:Key="Z.Raised">1</sys:Int32>
    <sys:Int32 x:Key="Z.Dropdown">10</sys:Int32>
    <sys:Int32 x:Key="Z.Overlay">40</sys:Int32>
    <sys:Int32 x:Key="Z.Toast">50</sys:Int32>
    <sys:Int32 x:Key="Z.Tooltip">60</sys:Int32>
</ResourceDictionary>
