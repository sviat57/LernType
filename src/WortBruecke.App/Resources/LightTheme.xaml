<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm-neutral light semantics. -->
    <Color x:Key="Color.Canvas">#F1EDE6</Color>
    <Color x:Key="Color.Surface">#A8FFFEFB</Color>
    <Color x:Key="Color.Raised">#E6FFFEFB</Color>
    <Color x:Key="Color.Sunken">#D9EAE4DA</Color>
    <Color x:Key="Color.Inverse">#292822</Color>
    <Color x:Key="Color.TextPrimary">#2C2A25</Color>
    <Color x:Key="Color.TextSecondary">#6D685F</Color>
    <Color x:Key="Color.TextTertiary">#918A7E</Color>
    <Color x:Key="Color.BorderSubtle">#E6E0D6</Color>
    <Color x:Key="Color.Border">#D8D1C6</Color>
    <Color x:Key="Color.Accent">#B94E36</Color>
    <Color x:Key="Color.AccentHover">#A43F2A</Color>
    <Color x:Key="Color.AccentPressed">#8F3523</Color>
    <Color x:Key="Color.AccentSoft">#F5DED7</Color>
    <Color x:Key="Color.AccentText">#9C3826</Color>
    <Color x:Key="Color.OnAccent">#FFF9F4</Color>
    <Color x:Key="Color.Success">#2F7254</Color>
    <Color x:Key="Color.SuccessSoft">#DDEEE5</Color>
    <Color x:Key="Color.Warning">#9A641C</Color>
    <Color x:Key="Color.WarningSoft">#F6E9CD</Color>
    <Color x:Key="Color.Error">#A83A3A</Color>
    <Color x:Key="Color.ErrorSoft">#F6DFDD</Color>
    <Color x:Key="Color.Info">#516778</Color>
    <Color x:Key="Color.InfoSoft">#E1E9EE</Color>
    <Color x:Key="Color.BackdropStart">#EAF7F2EB</Color>
    <Color x:Key="Color.BackdropMiddle">#EAF2EEE8</Color>
    <Color x:Key="Color.BackdropEnd">#EAE8EEF0</Color>
    <Color x:Key="Color.GlassSubtle">#80FFFEFB</Color>
    <Color x:Key="Color.GlassStandardTop">#CCFFFFFF</Color>
    <Color x:Key="Color.GlassStandardBottom">#A8F8F4ED</Color>
    <Color x:Key="Color.GlassStrongTop">#F2FFFFFF</Color>
    <Color x:Key="Color.GlassStrongBottom">#DDFBF8F2</Color>
    <Color x:Key="Color.GlassInset">#D9EAE4DA</Color>
    <Color x:Key="Color.GlassControl">#F2FFFEFB</Color>
    <Color x:Key="Color.GlassStrokeStart">#E6FFFFFF</Color>
    <Color x:Key="Color.GlassStrokeEnd">#4778685C</Color>
    <Color x:Key="Color.AuraAccent">#36B94E36</Color>
    <Color x:Key="Color.AuraSecondary">#285C7484</Color>
    <Color x:Key="Color.Shadow">#5A3B302B</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{DynamicResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Raised" Color="{DynamicResource Color.Raised}" />
    <SolidColorBrush x:Key="Brush.Sunken" Color="{DynamicResource Color.Sunken}" />
    <SolidColorBrush x:Key="Brush.Inverse" Color="{DynamicResource Color.Inverse}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{DynamicResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{DynamicResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{DynamicResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{DynamicResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{DynamicResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.ErrorSoft" Color="{DynamicResource Color.ErrorSoft}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{DynamicResource Color.InfoSoft}" />
    <LinearGradientBrush x:Key="Brush.AppBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.BackdropStart}" />
        <GradientStop Offset="0.48" Color="{DynamicResource Color.BackdropMiddle}" />
        <GradientStop Offset="1" Color="{DynamicResource Color.BackdropEnd}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.GlassSubtle" Color="{DynamicResource Color.GlassSubtle}" />
    <LinearGradientBrush x:Key="Brush.GlassStandard" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.GlassStandardTop}" />
        <GradientStop Offset="1" Color="{DynamicResource Color.GlassStandardBottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassStrong" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.GlassStrongTop}" />
        <GradientStop Offset="1" Color="{DynamicResource Color.GlassStrongBottom}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.GlassInset" Color="{DynamicResource Color.GlassInset}" />
    <SolidColorBrush x:Key="Brush.GlassControl" Color="{DynamicResource Color.GlassControl}" />
    <LinearGradientBrush x:Key="Brush.GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.GlassStrokeStart}" />
        <GradientStop Offset="1" Color="{DynamicResource Color.GlassStrokeEnd}" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Brush.AuraAccent" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="{DynamicResource Color.AuraAccent}" />
        <GradientStop Offset="1" Color="#00B94E36" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.AuraSecondary" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="{DynamicResource Color.AuraSecondary}" />
        <GradientStop Offset="1" Color="#005C7484" />
    </RadialGradientBrush>
</ResourceDictionary>
