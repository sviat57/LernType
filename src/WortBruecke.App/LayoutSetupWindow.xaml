<Window x:Class="WortBruecke.App.LayoutSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нужны раскладки клавиатуры"
        Width="620" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Настройка раскладок LernType">
    <Grid ClipToBounds="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource Brush.AppBackdrop}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse Width="420" Height="420" Margin="-210,-260,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Brush.AuraAccent}" />
            <Ellipse Width="380" Height="380" Margin="0,0,-230,-250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.AuraSecondary}" />
        </Grid>

        <Border Margin="20" Padding="30" Style="{StaticResource Panel}" CornerRadius="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="60" Height="60" Background="{DynamicResource Brush.WarningSoft}"
                            BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="18">
                        <Path Width="28" Height="28" Data="{StaticResource Icon.Keyboard}" Stroke="{DynamicResource Brush.Warning}"
                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetaText}" Foreground="{DynamicResource Brush.AccentText}" Text="ОДИН РАЗ ПЕРЕД СТАРТОМ" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource PageTitle}" FontSize="27" LineHeight="34" Text="Добавьте две раскладки" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource BodySecondary}" FontSize="14" LineHeight="21"
                               Text="LernType сам переключает язык в полях ответа. Для этого Windows должны быть доступны русская и немецкая раскладки — приложение не устанавливает их без вашего участия." />

                    <Border Grid.Row="2" Padding="8" Style="{StaticResource GlassInset}" CornerRadius="16">
                        <ItemsControl x:Name="LayoutList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="50" Margin="0,0,0,6" Padding="12,8" Background="{DynamicResource Brush.GlassStandard}"
                                            BorderBrush="{DynamicResource Brush.GlassStroke}" BorderThickness="1" CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="9">
                                                <Path Width="15" Height="15" Data="{StaticResource Icon.Keyboard}" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.7" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <Border Grid.Column="2" Padding="9,4" VerticalAlignment="Center" Background="{DynamicResource Brush.ErrorSoft}" CornerRadius="999">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Error}" Text="Не установлена" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock x:Name="RetryMessage" Grid.Row="3" Margin="2,10,2,0" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="12" LineHeight="18" AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button MinHeight="46" Style="{StaticResource SecondaryButton}" Click="OpenSettings"
                            AutomationProperties.Name="Открыть настройки языка Windows">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Margin="0,0,8,0" Data="{StaticResource Icon.Settings}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.4" Stretch="Uniform" />
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Настройки Windows" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" MinHeight="46" Style="{StaticResource PrimaryButton}" Click="Retry"
                            AutomationProperties.Name="Проверить раскладки снова">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonContentText}" Text="Проверить снова" />
                            <Path Width="17" Height="17" Margin="8,0,0,0" Data="{StaticResource Icon.ArrowRight}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" Stretch="Uniform" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
